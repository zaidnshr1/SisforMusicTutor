// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  GURU
  MURID
}

enum PaymentStatus {
  LUNAS
  TERLAMBAT
  MENUNGGAK
  BELUM_BAYAR
}

enum TransactionType {
  PEMASUKAN
  PENGELUARAN
  GAJI_GURU
  REVERSAL
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  role              Role      @default(MURID)
  isVerified        Boolean   @default(false) // Untuk verifikasi email & approval guru oleh admin
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  profile           Profile?
  enrollments       Enrollment[]
  reviews           Review[]
  reports           Report[]
  transactions      Transaction[]  @relation("UserInput")
  teacherPayments   TeacherPayment[]
  taughtClasses     Class[]          @relation("TeacherClasses")
}

model Profile {
  id          String   @id @default(cuid())
  fullName    String
  whatsapp    String?
  domicile    String?
  bio         String?
  education   String?
  experience  String?
  speciality  String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id          String       @id @default(cuid())
  title       String
  description String
  price       Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relasi
  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  reviews     Review[]
}

model Enrollment {
  id            String        @id @default(cuid())
  paymentStatus PaymentStatus @default(BELUM_BAYAR)
  enrolledAt    DateTime      @default(now())
  deletedAt     DateTime?

  studentId     String
  student       User          @relation(fields: [studentId], references: [id])
  classId       String
  class         Class         @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
}

model Report {
  id          String    @id @default(cuid())
  title       String
  description String
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  reporterId  String
  reporter    User      @relation(fields: [reporterId], references: [id])
}

model Transaction {
  id            String          @id @default(cuid())
  amount        Float
  type          TransactionType
  description   String
  notes         String?
  transactionAt DateTime        @default(now())

  ipAddress     String
  deviceInfo    String

  userId        String
  user          User   @relation("UserInput", fields: [userId], references: [id])

  reversalForId String?      @unique
  reversalFor   Transaction? @relation("Reversal", fields: [reversalForId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversedBy    Transaction? @relation("Reversal")

  teacherPayment TeacherPayment?
}

model TeacherPayment {
  id          String   @id @default(cuid())
  amount      Float
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())

  teacherId     String
  teacher       User        @relation(fields: [teacherId], references: [id])
  transactionId String      @unique 
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}
