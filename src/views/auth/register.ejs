<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AksaraNada | <%= title %></title>
</head>
<body>
    <h1>Registrasi Akun</h1>
    <% if (error) { %>
     <p style="color: crimson;"><%= error%></p>
    <% } %>

    <form action="/auth/register" method="post">
        <input type="text" name="fullName" placeholder="nama lengkap" required value="<%= typeof oldData !== "undefined" ? oldData.fullName : "" %>"><br>
        <input type="email" name="email" placeholder="email" required value="<%= typeof oldData !== "undefined" ? oldData.email : ""%>"><br>
        <input type="password" name="password" placeholder="password" required value="<%= typeof oldData !== "undefined" ? oldData.password : "" %>"><br>
        <input type="password" name="confirmPassword" placeholder="confirm password" required value="<%= typeof oldData !== "undefined" ? oldData.confirmPassword : "" %>"><br>
        <select name="role">
            <option value="MURID" <%= (typeof oldData !== 'undefined' && oldData.role === 'GURU') ? 'selected' : '' %>>>saya murid</option>
            <option value="GURU" <%= (typeof oldData !== 'undefined' && oldData.role === 'MURID') ? 'selected' : '' %>>>saya guru</option>
        </select><br>
        <button type="submit">Daftar</button>
    </form>
</body>
</html>