<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AksaraNada | <%= title%></title>
</head>
<body>
    <h1>Login</h1>
    <% if (error) { %>
     <p style="color: crimson;"><%= error %></p>
    <% } %>
    <form action="/auth/login" method="post">
        <input type="email" name="email" placeholder="email" required value="<%= typeof oldData !== "undefined" ? oldData.email : "" %>"><br>
        <input type="password" name="password" placeholder="password" required value="<%= typeof oldData !== "undefined" ? oldData.password : "" %>">
        <button type="submit">Login</button>
    </form>
</body>
</html>